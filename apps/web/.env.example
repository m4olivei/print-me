# Copy to apps/web/.env and fill in real values (the .env itself is git-ignored).
# Variables already set in the process environment (e.g. by systemd's
# EnvironmentFile=) take precedence over this file.

# Required. Absolute path to the shared SQLite database file; the worker must
# use the same file. Default matches the recommended Pi layout (see README);
# point it elsewhere, e.g. /tmp/print-me.sqlite, for local development.
DB_PATH=/opt/print-me/data/print-me.sqlite

# Optional (default 3100). Port the webhook listens on, always on 127.0.0.1.
# Must match web_port in infra/cloudflare, where the tunnel's ingress points.
PORT=3100

# Optional (default 20). Most print jobs that may be created in any one-hour
# window; POST /print returns 429 with Retry-After beyond it. A repeat request
# for a file that is already queued or printing does not count.
MAX_JOBS_PER_HOUR=20
