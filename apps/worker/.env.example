# apps/worker environment — copy this file to apps/worker/.env (git-ignored)
# and fill in real values. The worker loads .env from this package directory
# regardless of cwd; under systemd the same file is passed via EnvironmentFile=.

# Absolute path to the shared SQLite database file (the same file the web app uses).
# Default matches the recommended Pi layout (repo at /opt/print-me, owned by the
# print-me service user — see README).
DB_PATH=/opt/print-me/data/print-me.sqlite

# Absolute path to the Google service account's JSON key (Drive read-only).
# Keep it outside the checkout, readable only by the print-me user (chmod 600).
GOOGLE_APPLICATION_CREDENTIALS=/etc/print-me/service-account.json

# CUPS queue the worker submits jobs to with `lp -d`.
CUPS_PRINTER_NAME=scx4623fw

# The printer's network address. NOT read by the worker: used only by the
# documented `lpadmin` step that creates the CUPS queue. Use a DHCP-reserved
# address (see README: `lpstat -v <queue>` shows what CUPS uses).
PRINTER_DEVICE_URI=socket://<printer-ip>:9100

# Milliseconds between worker ticks; each tick handles at most one job
# (default 10000 when unset).
POLL_INTERVAL_MS=10000

# Largest Drive file the worker accepts, in bytes, checked from Drive metadata
# before downloading. Bigger files fail permanently (default 52428800 = 50 MB).
MAX_FILE_BYTES=52428800
